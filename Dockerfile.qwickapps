# QwickApps deployment Dockerfile for slack-mcp-server.
# This is a WRAPPER image — it pulls the pre-built binary from the upstream
# published image and runs it inside img-node with the canonical Tailscale
# entrypoint.
#
# This file is NOT upstream's Dockerfile (which builds from source).
# Upstream's Dockerfile is preserved at ./Dockerfile for reference.
#
# IMPORTANT: Port is controlled by the SLACK_MCP_PORT environment variable
# (default 13080). The binary does NOT accept a --port CLI flag. The SSE
# endpoint is served at :<SLACK_MCP_PORT>/sse.
#
# To update the upstream pin:
#   1. Find the new tag + digest:
#      docker manifest inspect ghcr.io/korotovsky/slack-mcp-server:<new-tag>
#   2. Update UPSTREAM_TAG and UPSTREAM_DIGEST below.
#   3. Update UPSTREAM.md with the new version and date.

# Global ARG must appear before any FROM so it can be referenced in the final
# stage's FROM directive (Docker multi-stage scope rule).
ARG QWICKAPPS_NODE_IMAGE=ghcr.io/qwickapps/img-node:latest

# Pin upstream by tag AND digest. Update both when syncing.
# v1.2.3 | sha256:7ae77761d9f6e8da2b0fc7e7bf9f489615865af533990e0e06bc3eed49e0b91e
FROM ghcr.io/korotovsky/slack-mcp-server:v1.2.3@sha256:7ae77761d9f6e8da2b0fc7e7bf9f489615865af533990e0e06bc3eed49e0b91e AS upstream

# Build stage for our own binaries (currently: token-bridge sidecar).
# Pinned to the Go toolchain version declared in go.mod.
FROM golang:1.24-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/token-bridge ./cmd/token-bridge
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/multiplexer ./cmd/multiplexer
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/setup ./cmd/setup

# img-node ships node + curl + tailscale + ca-certificates (built by qwickapps/node).
# qwickapps-base (the former base) did NOT include tailscale — containers crashed with
# "tailscaled socket not ready after 20s". Use the same base as qwickapps/mcp and qwickapps/forge.
FROM ${QWICKAPPS_NODE_IMAGE}
USER root

# Pull upstream binary out of upstream image.
# Source path confirmed from upstream Dockerfile: /usr/local/bin/mcp-server
COPY --from=upstream /usr/local/bin/mcp-server /usr/local/bin/mcp-server

# QwickApps token-bridge sidecar (see cmd/token-bridge). Selected via CMD
# override at the CapRover-app level — this image ships all three binaries.
COPY --from=builder /out/token-bridge /usr/local/bin/token-bridge

# QwickApps multiplexer (see cmd/multiplexer). Fronts per-team mcp-server
# children; selected via CMD override at the CapRover-app level.
COPY --from=builder /out/multiplexer /usr/local/bin/multiplexer

# QwickApps setup service (see cmd/setup). Tailscale-only install page that
# templates the userscript; selected via CMD override at the CapRover-app level.
COPY --from=builder /out/setup /usr/local/bin/setup

# SQL migrations applied by token-bridge on startup.
COPY --from=builder /src/migrations /app/migrations

# Tailscale entrypoint (QwickApps canonical v1.2 — do not customize).
COPY entrypoint.qwickapps.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

WORKDIR /app

# SLACK_MCP_PORT controls the SSE/HTTP bind port (upstream reads this env var).
# SLACK_MCP_HOST controls the bind host (default 127.0.0.1 upstream; set to
# 0.0.0.0 so CapRover's proxy can reach the container port).
# PORT is read by the Tailscale entrypoint to set up `tailscale serve`.
ENV PORT=13080 \
    SLACK_MCP_PORT=13080 \
    SLACK_MCP_HOST=0.0.0.0

EXPOSE 13080
# 13082 is the multiplexer's HTTP listen port (MULTIPLEXER_PORT env var).
EXPOSE 13082
# 13083 is the setup service's HTTP listen port (SETUP_PORT env var). Tailscale-only;
# never wire a public CapRover proxy rule to this port.
EXPOSE 13083

# entrypoint.sh sets up Tailscale + Tailscale Serve, then exec's CMD.
ENTRYPOINT ["/app/entrypoint.sh"]

# Default CMD runs the upstream mcp-server binary in SSE mode.
# CapRover deployments override CMD per-app to select the desired binary:
#   - upstream mcp-server (SSE, single-tenant): CMD ["/usr/local/bin/mcp-server", "--transport", "sse"]
#   - token-bridge sidecar:                     CMD ["/usr/local/bin/token-bridge"]
#   - multiplexer (multi-tenant, P3):           CMD ["/usr/local/bin/multiplexer"]
#   - setup service (Tailscale-only, P4):       CMD ["/usr/local/bin/setup"]
CMD ["/usr/local/bin/mcp-server", "--transport", "sse"]

# Do not define an image-level Docker HEALTHCHECK here. This image backs
# multiple CapRover apps with different CMD overrides and health endpoints;
# deploy-app.yml configures each app's own healthPath (for example /_health).
