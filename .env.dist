# User OAuth Token (starts with xoxp-)
SLACK_MCP_XOXP_TOKEN="" # Replace with your user OAuth token

# Bot OAuth Token (starts with xoxb-)
SLACK_MCP_XOXB_TOKEN="" # Replace with your bot token

# Session-based tokens (browser tokens)
SLACK_MCP_XOXC_TOKEN="" # Replace with your actual token
SLACK_MCP_XOXD_TOKEN="" # Replace with your actual token

# SSE API Key for authentication
SLACK_MCP_SSE_API_KEY="" # Replace with your actual API key

# --- Token bridge sidecar (cmd/token-bridge) ---
# Stores xoxc/xoxd tokens encrypted at rest. Receives refreshes from the
# Tampermonkey userscript (P4) over HMAC-authed POST /api/tokens/refresh.

TOKEN_BRIDGE_PORT=13081                 # listen port (default 13081)
TOKEN_BRIDGE_HOST=0.0.0.0               # listen host (default 0.0.0.0)
TOKEN_ENCRYPTION_KEY=                   # base64-encoded 32 bytes (AES-256-GCM); generate: openssl rand -base64 32
BRIDGE_HMAC_KEY=                        # shared secret with the userscript
DATABASE_URL=                           # postgres URL; uses qwickapps-db (slack_mcp_server_dev DB) in deployed env

# --- Multiplexer (cmd/multiplexer) ---
# Fronts per-team upstream mcp-server children; lazy-spawns each child
# with decrypted xoxc/xoxd credentials read from the token-bridge DB.

MULTIPLEXER_PORT=13082                  # listen port (default 13082)
MULTIPLEXER_HOST=0.0.0.0               # listen host (default 0.0.0.0)
MULTIPLEXER_SERVICE_KEY=               # bearer token required by callers; generate: openssl rand -hex 32
MULTIPLEXER_IDLE_TIMEOUT=10m           # how long an unused child process runs before being reaped (default 10m)
MULTIPLEXER_POLL_INTERVAL=30s          # how often to poll workspaces for token refreshes (default 30s)
MCP_SERVER_BIN=/usr/local/bin/mcp-server  # path to the upstream mcp-server binary in the container